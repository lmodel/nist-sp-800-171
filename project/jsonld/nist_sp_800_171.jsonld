      ],
      "slots": [
        "sp800171Reference__cited_publication",
        "sp800171Reference__cited_publication_citation",
        "sp800171Reference__cited_publication_url"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cited_publication",
          "description": "The publication's short name, such as SP 800-63-3.",
          "range": "sp800171_cited_publication_name",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cited_publication_citation",
          "description": "The full citation, as the catalog's back matter gives it.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cited_publication_url",
          "description": "The publication's address, which the catalog gives as its digital object identifier at doi.org.",
          "range": "uri",
          "required": true,
          "pattern": "^https://doi\\.org/10\\.[0-9]+/\\S+$",
          "@type": "SlotDefinition"
        }
      ],
