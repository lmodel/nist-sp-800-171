    {
      "name": "description",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/description",
      "description": "What the family or requirement is about, in the words of whoever records it. SP 800-171 gives a family no text of its own, and a requirement's own text goes in its statement, items and discussion.",
      "comments": [
        "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "mappings": [
        "http://schema.org/description"
      ],
      "slot_uri": "http://schema.org/description",
      "owner": "Sp800171Requirement",
      "domain_of": [
        "Sp800171Family",
        "Sp800171Requirement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp800171Publication__sp800171_revision",
