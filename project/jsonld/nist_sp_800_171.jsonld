    {
      "name": "Sp800171Publication",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Publication",
      "description": "One revision of SP 800-171 as a whole: its requirement families, each holding its security requirements, with the assessment procedures of the matching revision of SP 800-171A inside each requirement.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/171/r3/final"
      ],
      "mappings": [
        "nist_sp_800_171:Publication"
      ],
      "broad_mappings": [
        "oscal:Catalog"
      ],
      "slots": [
        "sp800171Publication__sp800171_revision",
        "sp800171Publication__requirement_families"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sp800171_revision",
          "description": "The revision of SP 800-171 the document renders, as NIST numbers it, such as 3.",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_families",
          "description": "The requirement families, in the order SP 800-171 gives them.",
          "range": "Sp800171Family",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/Publication",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171Family",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family",
      "description": "One of the seventeen families that SP 800-171 Revision 3 sorts its security requirements into, such as Access Control (03.01) or Supply Chain Risk Management (03.17).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/171/r3/final"
      ],
      "mappings": [
        "nist_sp_800_171:Family"
      ],
      "broad_mappings": [
        "oscal:Group"
      ],
      "slots": [
        "Sp800171Family_title",
        "description",
        "sp800171Family__family_number",
        "sp800171Family__family_requirements"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "family_number",
          "description": "The family's number, such as 03.01.",
          "range": "sp800171_family_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "family_requirements",
          "description": "The security requirements of the family, the withdrawn ones included, in the order SP 800-171 numbers them. A knowledge bundle relates a requirement to its family with isPartOf instead.",
          "range": "Sp800171Requirement",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/Family",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171Requirement",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement",
      "description": "A security requirement of SP 800-171: a numbered, named requirement for protecting CUI, with its statement, discussion, references and source controls, the organization-defined parameters its statement leaves open, and the assessment objectives and methods SP 800-171A gives it. A requirement that Revision 3 withdrew keeps its number and says which requirements took its place.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/171/r3/final"
      ],
      "mappings": [
        "nist_sp_800_171:Requirement"
      ],
      "broad_mappings": [
        "oscal:Control"
      ],
      "slots": [
        "title",
        "description",
        "sp800171Requirement__requirement_id",
        "sp800171Requirement__requirement_status",
        "sp800171Requirement__incorporated_into_requirements",
        "sp800171Requirement__addressed_by_requirements",
        "sp800171Requirement__requirement_statement",
        "sp800171Requirement__requirement_items",
        "sp800171Requirement__requirement_discussion",
        "sp800171Requirement__requirement_parameters",
        "sp800171Requirement__requirement_objectives",
        "sp800171Requirement__requirement_methods",
        "sp800171Requirement__requirement_references",
        "sp800171Requirement__source_controls"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "requirement_id",
          "description": "The requirement's identifier, such as 03.01.01.",
          "range": "sp800171_requirement_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_status",
          "description": "Withdrawn when Revision 3 withdrew the requirement. A requirement with no status is in force.",
          "range": "Sp800171RequirementStatus",
          "@type": "SlotDefinition"
        },
        {
          "name": "incorporated_into_requirements",
          "description": "For a withdrawn requirement, the requirements of Revision 3 that incorporate what it required, as the catalog states them.",
          "range": "sp800171_requirement_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "addressed_by_requirements",
          "description": "For a withdrawn requirement, the requirements of Revision 3 that address what it required, as the catalog states them.",
          "range": "sp800171_requirement_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_statement",
          "description": "The requirement statement when SP 800-171 writes it as one piece of text and not as lettered items. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter.",
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_items",
          "description": "The lettered items of the requirement statement, in order, each with its numbered items where it has them. A requirement has either these or a statement, never both.",
          "range": "Sp800171RequirementItem",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_discussion",
          "description": "The requirement's discussion: SP 800-171's explanation of what the requirement means and how it relates to other requirements.",
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_parameters",
          "description": "The organization-defined parameters the requirement statement leaves to the organization, in the order SP 800-171A numbers them.",
          "range": "Sp800171Parameter",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_objectives",
          "description": "The assessment objectives SP 800-171A gives the requirement: the determination statements an assessor checks.",
          "range": "Sp800171AssessmentObjective",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_methods",
          "description": "The assessment methods SP 800-171A gives the requirement, each with the objects it is applied to.",
          "range": "Sp800171AssessmentMethod",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_references",
          "description": "The publications SP 800-171 lists under the requirement's references, each with its citation and address as the catalog gives them.",
          "range": "Sp800171Reference",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "source_controls",
          "description": "The controls of SP 800-53 Revision 5 the requirement is drawn from, by their identifiers, as the catalog lists them among the requirement's references. The identifier is data; the schema maps nothing to a model of SP 800-53.",
          "range": "sp800171_source_control_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/Requirement",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171RequirementItem",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementItem",
      "description": "One item of a requirement statement: a lettered item such as 03.01.01.a, or a numbered item under a lettered one such as 03.01.01.c.01.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/171/r3/final"
      ],
      "mappings": [
        "nist_sp_800_171:RequirementItem"
      ],
      "broad_mappings": [
        "oscal:Part"
      ],
      "slots": [
        "sp800171RequirementItem__requirement_item_id",
        "sp800171RequirementItem__requirement_item_text",
        "sp800171RequirementItem__requirement_subitems"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "requirement_item_id",
          "description": "The item's identifier, such as 03.01.01.a.",
          "range": "sp800171_item_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_item_text",
          "description": "What the item requires. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter.",
          "required": true,
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_subitems",
          "description": "The numbered items under a lettered item, in order.",
          "range": "Sp800171RequirementItem",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/RequirementItem",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171Parameter",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Parameter",
      "description": "An organization-defined parameter (ODP): a value, such as a time period or a frequency, that a requirement statement leaves to the organization, with the guideline SP 800-171A gives for defining it. A few parameters are a selection among choices instead of a value.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://doi.org/10.6028/NIST.SP.800-171Ar3"
      ],
      "mappings": [
        "nist_sp_800_171:Parameter"
      ],
      "broad_mappings": [
        "oscal:Parameter"
      ],
      "slots": [
        "sp800171Parameter__odp_id",
        "sp800171Parameter__odp_label",
        "sp800171Parameter__odp_usage",
        "sp800171Parameter__odp_guideline",
        "sp800171Parameter__odp_choices",
        "sp800171Parameter__odp_selection_count"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "odp_id",
          "description": "The parameter's identifier, such as A.03.01.01.ODP[01].",
          "range": "sp800171_odp_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "odp_label",
          "description": "What kind of value the parameter takes, such as time period or frequency, or SELECTED PARAMETER VALUES for a selection.",
          "required": true,
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        },
        {
          "name": "odp_usage",
          "description": "How the requirement statement names the parameter, such as organization-defined time period.",
          "@type": "SlotDefinition"
        },
        {
          "name": "odp_guideline",
          "description": "The determination SP 800-171A gives for the parameter: what the organization must have defined, such as the time period for account inactivity before disabling is defined.",
          "@type": "SlotDefinition"
        },
        {
          "name": "odp_choices",
          "description": "For a selection, the choices SP 800-171 offers, in its order. A choice may itself carry an insert placeholder naming another parameter.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "odp_selection_count",
          "description": "How many of the choices a selection takes.",
          "range": "Sp800171SelectionCount",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/Parameter",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171AssessmentObjective",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentObjective",
      "description": "An assessment objective of SP 800-171A: one determination statement that an assessor checks, tied to the requirement or to one item of its statement.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://doi.org/10.6028/NIST.SP.800-171Ar3"
      ],
      "mappings": [
        "nist_sp_800_171:AssessmentObjective"
      ],
      "broad_mappings": [
        "oscal:Part"
      ],
      "slots": [
        "sp800171AssessmentObjective__requirement_objective_id",
        "sp800171AssessmentObjective__requirement_determination",
        "sp800171AssessmentObjective__assessed_requirement_item"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "requirement_objective_id",
          "description": "The objective's identifier, such as A.03.01.01.b[01].",
          "range": "sp800171_objective_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_determination",
          "description": "The determination statement: what the assessor determines is the case, such as system accounts are created in accordance with organizational policy, procedures, prerequisites, and criteria.",
          "required": true,
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        },
        {
          "name": "assessed_requirement_item",
          "description": "The statement item the objective assesses, such as 03.01.01.b. Absent when the objective assesses a requirement whose statement is one piece of text.",
          "range": "sp800171_item_identifier",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/AssessmentObjective",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171AssessmentMethod",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethod",
      "description": "One of the three assessment methods SP 800-171A applies to a requirement, examine, interview or test, with the assessment objects (documents, people, processes or mechanisms) it is applied to.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://doi.org/10.6028/NIST.SP.800-171Ar3"
      ],
      "mappings": [
        "nist_sp_800_171:AssessmentMethod"
      ],
      "broad_mappings": [
        "oscal:Part"
      ],
      "slots": [
        "sp800171AssessmentMethod__requirement_method_kind",
        "sp800171AssessmentMethod__requirement_method_objects"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "requirement_method_kind",
          "description": "Which method it is.",
          "range": "Sp800171AssessmentMethodKind",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "requirement_method_objects",
          "description": "The assessment objects, one entry each, in the order SP 800-171A lists them, such as access control policy and procedures or system administrators.",
          "required": true,
          "multivalued": true,
          "pattern": "^\\s*\\S",
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-171/AssessmentMethod",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp800171Reference",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Reference",
      "description": "A publication that SP 800-171 lists under a requirement's references, by the short name the publication gives it, with the full citation and the address NIST's catalog gives it.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/171/r3/final"
      ],
      "mappings": [
        "nist_sp_800_171:Reference"
