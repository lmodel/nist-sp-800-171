    }
  ],
  "default_prefix": "nist_sp_800_171",
  "default_range": "string",
  "types": [
    {
      "name": "sp800171_family_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171FamilyIdentifier",
      "description": "A family's number, as SP 800-171 Revision 3 numbers its seventeen families: 03, a dot and two digits from 01 to 17, such as 03.01 for Access Control.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^03\\.(0[1-9]|1[0-7])$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_requirement_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementIdentifier",
      "description": "A security requirement's identifier: its family's number, a dot and the requirement's two-digit number within the family, such as 03.01.01.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_item_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171ItemIdentifier",
      "description": "The identifier of a lettered item of a requirement statement, such as 03.01.01.a, or of a numbered item under it, such as 03.01.01.c.01.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])\\.[a-z](\\.(0[1-9]|[1-9][0-9]))?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_odp_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171OdpIdentifier",
      "description": "An organization-defined parameter's identifier, as SP 800-171A writes it: A, the requirement's identifier, ODP and the parameter's two-digit number in square brackets, such as A.03.01.01.ODP[01].",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^A\\.03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])\\.ODP\\[(0[1-9]|[1-9][0-9])\\]$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_objective_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171ObjectiveIdentifier",
      "description": "An assessment objective's identifier, as SP 800-171A writes it: A and the identifier of the requirement or statement item it assesses, such as A.03.01.01.e, with a two-digit number in square brackets when that item has several objectives, such as A.03.01.01.b[01]. NIST's catalog writes the bracketed number as a dotted one, A.03.01.01.b.01.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^A\\.03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])(\\.[a-z](\\.(0[1-9]|[1-9][0-9]))?)?(\\[(0[1-9]|[1-9][0-9])\\])?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_source_control_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171SourceControlIdentifier",
      "description": "The identifier of a control of SP 800-53 Revision 5 as NIST's catalog of SP 800-171 writes it: the family's two letters, a hyphen and the control's two-digit number, with a two-digit enhancement number in parentheses where it is one, such as AC-02 and AC-02(03).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[A-Z]{2}-(0[1-9]|[1-9][0-9])(\\((0[1-9]|[1-9][0-9])\\))?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp800171_cited_publication_name",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-171/Sp800171CitedPublicationName",
      "description": "The short name SP 800-171 gives a publication it references: the series (SP, FIPS or IR) and the publication's number, with the number of a part or volume where the publication has one, such as SP 800-57-1, SP 800-160-1, IR 8011-2 or FIPS 140-3. The short name leaves out the publication's revision, which the citation and the address carry: SP 800-53 stands for Revision 5.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-171",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(FIPS|IR|SP) [1-9][0-9]*(-[0-9A-Z]+)*$",
      "@type": "TypeDefinition"
    },
    {
