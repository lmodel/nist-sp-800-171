<https://w3id.org/lmodel/nist-sp-800-171/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/description"^^xsd:anyURI ;
	linkml:description "What the family or requirement is about, in the words of whoever records it. SP 800-171 gives a family no text of its own, and a requirement's own text goes in its statement, items and discussion." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:slot_uri "http://schema.org/description"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/double> a linkml:TypeDefinition ;
	skos:closeMatch "schema:Float"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Double"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:double specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/examine> linkml:description "Reviewing, inspecting, observing, studying or analysing assessment objects such as policies, plans, records and configurations." .
<https://w3id.org/lmodel/nist-sp-800-171/family_number> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:note "A slot of its own, listed first in Sp800171Family's slots, rather than an attribute, so that the generated Python dataclasses key a list of families by their number and not by their title: they key an inlined list by the first required slot of the class, and a class lists its slots before its attributes. The adapt copy roots the family on LOKF's Concept, whose id is its identifier, so the number cannot be marked as one." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/family_number"^^xsd:anyURI ;
	linkml:description "The family's number, such as 03.01." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_family_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/family_number"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/family_requirements> a linkml:SlotDefinition ;
	linkml:description "The security requirements of the family, the withdrawn ones included, in the order SP 800-171 numbers them. A knowledge bundle relates a requirement to its family with isPartOf instead." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> .
<https://w3id.org/lmodel/nist-sp-800-171/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/incorporated_into_requirements> a linkml:SlotDefinition ;
	linkml:description "For a withdrawn requirement, the requirements of Revision 3 that incorporate what it required, as the catalog states them." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_requirement_identifier> .
<https://w3id.org/lmodel/nist-sp-800-171/integer> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"." ;
	skos:exactMatch "schema:Integer"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/interview> linkml:description "Holding discussions with people such as administrators and personnel with security responsibilities." .
<https://w3id.org/lmodel/nist-sp-800-171/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpath"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/jsonpointer> dcterms:conformsTo "https://datatracker.ietf.org/doc/html/rfc6901" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpointer"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/ncname> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NCName" ;
	linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
	linkml:description "Prefix part of CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/nist_sp_800_171> dcterms:license "Apache-2.0" ;
	dcterms:source "https://doi.org/10.6028/NIST.SP.800-171r3"^^xsd:anyURI ;
	dcterms:title "Protecting Controlled Unclassified Information in Nonfederal Systems and Organizations (SP 800-171 Revision 3)" ;
	pav:version "3.0.0" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/projects/protecting-controlled-unclassified-information"^^xsd:anyURI , "https://csrc.nist.gov/pubs/sp/800/171/r3/final"^^xsd:anyURI , "https://doi.org/10.6028/NIST.SP.800-171Ar3"^^xsd:anyURI , "https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-171/rev3"^^xsd:anyURI , "https://lmodel.github.io/nist-sp-800-171"^^xsd:anyURI ;
	skos:note "NIST's catalog renders each family as an OSCAL group, each security requirement as an OSCAL control of class requirement, each statement item, discussion, assessment objective and assessment method as a part, each organization-defined parameter as a parameter, and each reference and source control as a link to a back-matter resource. The broad_mappings name those lmodel/oscal classes." , "SP 800-171 is a work of the United States Government and is not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each requirement, discussion, parameter and assessment procedure stays in the catalog copy." , "The version is the revision of SP 800-171 the schema renders, written as NIST's Cybersecurity and Privacy Reference Tool numbers it (SP_800_171_3_0_0), and source is the publication's digital object identifier. The catalog NIST publishes for that revision in usnistgov/oscal-content, which carries the assessment procedures of SP 800-171A Revision 3 as well, is copied to src/nist_sp_800_171/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer revision or changes the catalog. The catalog's own metadata version (1.1.0) numbers the catalog, not the publication. The release tags are the schema's own versions." ;
	sh:declare _:c14n2 , _:c14n3 , _:c14n4 , _:c14n6 , _:c14n7 ;
	linkml:annotations _:c14n0 , _:c14n13 , _:c14n15 , _:c14n5 ;
	linkml:classes <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethod> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentObjective> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Parameter> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Publication> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Reference> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementItem> ;
	linkml:default_prefix "nist_sp_800_171" ;
	linkml:default_range <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:description "A LinkML model of NIST Special Publication 800-171 Revision 3, the security requirements for protecting controlled unclassified information (CUI) in nonfederal systems and organizations: its seventeen requirement families, each security requirement with its statement, discussion, references and source controls, the organization-defined parameters (ODPs) a requirement leaves to the organization, and the assessment objectives and methods that SP 800-171A Revision 3 gives each requirement." ;
	linkml:enums <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethodKind> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementStatus> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171SelectionCount> ;
	linkml:id "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family_title> , <https://w3id.org/lmodel/nist-sp-800-171/description> , <https://w3id.org/lmodel/nist-sp-800-171/family_number> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentMethod__requirement_method_kind> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentMethod__requirement_method_objects> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentObjective__assessed_requirement_item> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentObjective__requirement_determination> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentObjective__requirement_objective_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Family__family_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_choices> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_guideline> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_label> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_selection_count> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_usage> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Publication__requirement_families> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Publication__sp800171_revision> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication_citation> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication_url> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171RequirementItem__requirement_item_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171RequirementItem__requirement_item_text> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171RequirementItem__requirement_subitems> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__addressed_by_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__incorporated_into_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_discussion> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_items> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_methods> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_objectives> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_parameters> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_references> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_statement> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_status> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__source_controls> , <https://w3id.org/lmodel/nist-sp-800-171/title> ;
	linkml:source_file "nist_sp_800_171.yaml" ;
	linkml:source_file_date "2026-11-07T02:04:02"^^xsd:dateTime ;
	linkml:source_file_size 20697 ;
	linkml:types <https://w3id.org/lmodel/nist-sp-800-171/boolean> , <https://w3id.org/lmodel/nist-sp-800-171/curie> , <https://w3id.org/lmodel/nist-sp-800-171/date> , <https://w3id.org/lmodel/nist-sp-800-171/date_or_datetime> , <https://w3id.org/lmodel/nist-sp-800-171/datetime> , <https://w3id.org/lmodel/nist-sp-800-171/decimal> , <https://w3id.org/lmodel/nist-sp-800-171/double> , <https://w3id.org/lmodel/nist-sp-800-171/float> , <https://w3id.org/lmodel/nist-sp-800-171/integer> , <https://w3id.org/lmodel/nist-sp-800-171/jsonpath> , <https://w3id.org/lmodel/nist-sp-800-171/jsonpointer> , <https://w3id.org/lmodel/nist-sp-800-171/ncname> , <https://w3id.org/lmodel/nist-sp-800-171/nodeidentifier> , <https://w3id.org/lmodel/nist-sp-800-171/objectidentifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_cited_publication_name> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_family_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_item_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_objective_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_odp_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_requirement_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_source_control_identifier> , <https://w3id.org/lmodel/nist-sp-800-171/sparqlpath> , <https://w3id.org/lmodel/nist-sp-800-171/string> , <https://w3id.org/lmodel/nist-sp-800-171/time> , <https://w3id.org/lmodel/nist-sp-800-171/uri> , <https://w3id.org/lmodel/nist-sp-800-171/uriorcurie> .
<https://w3id.org/lmodel/nist-sp-800-171/nodeidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NodeIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Nodeidentifier"^^xsd:anyURI ;
	linkml:description "A URI, CURIE or BNODE that represents a node in a model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#nonLiteral"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/objectidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "Used for inheritance and type checking" ;
	linkml:base "ElementIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
