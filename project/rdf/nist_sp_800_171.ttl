	linkml:description "The three assessment methods of SP 800-171A." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-sp-800-171/examine> , <https://w3id.org/lmodel/nist-sp-800-171/interview> , <https://w3id.org/lmodel/nist-sp-800-171/test> .
