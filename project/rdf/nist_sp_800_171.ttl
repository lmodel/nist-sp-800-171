	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/odp_choices> a linkml:SlotDefinition ;
	linkml:description "For a selection, the choices SP 800-171 offers, in its order. A choice may itself carry an insert placeholder naming another parameter." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-sp-800-171/odp_guideline> a linkml:SlotDefinition ;
	linkml:description "The determination SP 800-171A gives for the parameter: what the organization must have defined, such as the time period for account inactivity before disabling is defined." .
<https://w3id.org/lmodel/nist-sp-800-171/odp_id> a linkml:SlotDefinition ;
	linkml:description "The parameter's identifier, such as A.03.01.01.ODP[01]." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_odp_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/odp_label> a linkml:SlotDefinition ;
	linkml:description "What kind of value the parameter takes, such as time period or frequency, or SELECTED PARAMETER VALUES for a selection." ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/odp_selection_count> a linkml:SlotDefinition ;
	linkml:description "How many of the choices a selection takes." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171SelectionCount> .
<https://w3id.org/lmodel/nist-sp-800-171/odp_usage> a linkml:SlotDefinition ;
	linkml:description "How the requirement statement names the parameter, such as organization-defined time period." .
<https://w3id.org/lmodel/nist-sp-800-171/one> linkml:description "Exactly one of the choices." .
<https://w3id.org/lmodel/nist-sp-800-171/one_or_more> linkml:description "One or more of the choices." .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_determination> a linkml:SlotDefinition ;
	linkml:description "The determination statement: what the assessor determines is the case, such as system accounts are created in accordance with organizational policy, procedures, prerequisites, and criteria." ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_discussion> a linkml:SlotDefinition ;
	linkml:description "The requirement's discussion: SP 800-171's explanation of what the requirement means and how it relates to other requirements." ;
	linkml:pattern "^\\s*\\S" .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_families> a linkml:SlotDefinition ;
	linkml:description "The requirement families, in the order SP 800-171 gives them." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_id> a linkml:SlotDefinition ;
	linkml:description "The requirement's identifier, such as 03.01.01." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_requirement_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_item_id> a linkml:SlotDefinition ;
	linkml:description "The item's identifier, such as 03.01.01.a." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_item_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_item_text> a linkml:SlotDefinition ;
	linkml:description "What the item requires. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter." ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_items> a linkml:SlotDefinition ;
	linkml:description "The lettered items of the requirement statement, in order, each with its numbered items where it has them. A requirement has either these or a statement, never both." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementItem> .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_method_kind> a linkml:SlotDefinition ;
	linkml:description "Which method it is." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethodKind> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_method_objects> a linkml:SlotDefinition ;
	linkml:description "The assessment objects, one entry each, in the order SP 800-171A lists them, such as access control policy and procedures or system administrators." ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_methods> a linkml:SlotDefinition ;
	linkml:description "The assessment methods SP 800-171A gives the requirement, each with the objects it is applied to." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethod> .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_objective_id> a linkml:SlotDefinition ;
	linkml:description "The objective's identifier, such as A.03.01.01.b[01]." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_objective_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/requirement_objectives> a linkml:SlotDefinition ;
	linkml:description "The assessment objectives SP 800-171A gives the requirement: the determination statements an assessor checks." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentObjective> .
