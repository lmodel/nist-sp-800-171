	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_choices> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_guideline> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_label> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_selection_count> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Parameter__odp_usage> .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171Publication> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/pubs/sp/800/171/r3/final"^^xsd:anyURI ;
	skos:broadMatch "oscal:Catalog"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_171:Publication"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-171/requirement_families> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171_revision> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-171/Publication"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Publication"^^xsd:anyURI ;
	linkml:description "One revision of SP 800-171 as a whole: its requirement families, each holding its security requirements, with the assessment procedures of the matching revision of SP 800-171A inside each requirement." ;
	linkml:slot_usage _:c14n12 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/sp800171Publication__requirement_families> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Publication__sp800171_revision> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171Reference> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/pubs/sp/800/171/r3/final"^^xsd:anyURI ;
	skos:broadMatch "oscal:Resource"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_171:Reference"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
