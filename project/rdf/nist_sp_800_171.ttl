	linkml:description "The assessment methods SP 800-171A gives the requirement, each with the objects it is applied to." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethod> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_methods"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_objectives> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "requirement_objectives" ;
	linkml:description "The assessment objectives SP 800-171A gives the requirement: the determination statements an assessor checks." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentObjective> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_objectives"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_parameters> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "requirement_parameters" ;
	linkml:description "The organization-defined parameters the requirement statement leaves to the organization, in the order SP 800-171A numbers them." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Parameter> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_parameters"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_references> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "requirement_references" ;
	linkml:description "The publications SP 800-171 lists under the requirement's references, each with its citation and address as the catalog gives them." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Reference> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_references"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_statement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "requirement_statement" ;
	linkml:description "The requirement statement when SP 800-171 writes it as one piece of text and not as lettered items. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:pattern "^\\s*\\S" ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_statement"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_status> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "requirement_status" ;
	linkml:description "Withdrawn when Revision 3 withdrew the requirement. A requirement with no status is in force." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementStatus> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/requirement_status"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__source_controls> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:prefLabel "source_controls" ;
	linkml:description "The controls of SP 800-53 Revision 5 the requirement is drawn from, by their identifiers, as the catalog lists them among the requirement's references. The identifier is data; the schema maps nothing to a model of SP 800-53." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/sp800171_source_control_identifier> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-171/source_controls"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_cited_publication_name> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171CitedPublicationName"^^xsd:anyURI ;
	linkml:description "The short name SP 800-171 gives a publication it references: the series (SP, FIPS or IR) and the publication's number, with the number of a part or volume where the publication has one, such as SP 800-57-1, SP 800-160-1, IR 8011-2 or FIPS 140-3. The short name leaves out the publication's revision, which the citation and the address carry: SP 800-53 stands for Revision 5." ;
	linkml:pattern "^(FIPS|IR|SP) [1-9][0-9]*(-[0-9A-Z]+)*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_family_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171FamilyIdentifier"^^xsd:anyURI ;
	linkml:description "A family's number, as SP 800-171 Revision 3 numbers its seventeen families: 03, a dot and two digits from 01 to 17, such as 03.01 for Access Control." ;
	linkml:pattern "^03\\.(0[1-9]|1[0-7])$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_item_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171ItemIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier of a lettered item of a requirement statement, such as 03.01.01.a, or of a numbered item under it, such as 03.01.01.c.01." ;
	linkml:pattern "^03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])\\.[a-z](\\.(0[1-9]|[1-9][0-9]))?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_objective_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171ObjectiveIdentifier"^^xsd:anyURI ;
	linkml:description "An assessment objective's identifier, as SP 800-171A writes it: A and the identifier of the requirement or statement item it assesses, such as A.03.01.01.e, with a two-digit number in square brackets when that item has several objectives, such as A.03.01.01.b[01]. NIST's catalog writes the bracketed number as a dotted one, A.03.01.01.b.01." ;
	linkml:pattern "^A\\.03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])(\\.[a-z](\\.(0[1-9]|[1-9][0-9]))?)?(\\[(0[1-9]|[1-9][0-9])\\])?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_odp_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171OdpIdentifier"^^xsd:anyURI ;
	linkml:description "An organization-defined parameter's identifier, as SP 800-171A writes it: A, the requirement's identifier, ODP and the parameter's two-digit number in square brackets, such as A.03.01.01.ODP[01]." ;
	linkml:pattern "^A\\.03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])\\.ODP\\[(0[1-9]|[1-9][0-9])\\]$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_requirement_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementIdentifier"^^xsd:anyURI ;
	linkml:description "A security requirement's identifier: its family's number, a dot and the requirement's two-digit number within the family, such as 03.01.01." ;
	linkml:pattern "^03\\.(0[1-9]|1[0-7])\\.(0[1-9]|[1-9][0-9])$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_revision> a linkml:SlotDefinition ;
	linkml:description "The revision of SP 800-171 the document renders, as NIST numbers it, such as 3." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-171/sp800171_source_control_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171SourceControlIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier of a control of SP 800-53 Revision 5 as NIST's catalog of SP 800-171 writes it: the family's two letters, a hyphen and the control's two-digit number, with a two-digit enhancement number in parentheses where it is one, such as AC-02 and AC-02(03)." ;
	linkml:pattern "^[A-Z]{2}-(0[1-9]|[1-9][0-9])(\\((0[1-9]|[1-9][0-9])\\))?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/test> linkml:description "Exercising mechanisms or processes under specified conditions and comparing the result with what is expected." .
<https://w3id.org/lmodel/nist-sp-800-171/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/title"^^xsd:anyURI ;
	linkml:description "The name SP 800-171 gives a family or a security requirement, such as Access Control or Account Management." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> , <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-171/withdrawn> linkml:description "Revision 3 withdrew the requirement; other requirements incorporate or address what it required, or nothing does." .
_:c14n0 skos:example "SP_800_171_3_0_0" ;
	linkml:tag "cprt_framework_version"^^xsd:anyURI .
_:c14n13 skos:example "v1.6.0" ;
	linkml:tag "oscal_content_tag"^^xsd:anyURI .
_:c14n15 skos:example "f0de6d8d8c059d374f15e0ae07508d82e370fc1d" ;
	linkml:tag "oscal_content_commit"^^xsd:anyURI .
_:c14n2 sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
	sh:prefix "xsd" .
_:c14n3 sh:namespace "https://w3id.org/lmodel/oscal/"^^xsd:anyURI ;
	sh:prefix "oscal" .
_:c14n4 sh:namespace "https://w3id.org/linkml/"^^xsd:anyURI ;
	sh:prefix "linkml" .
_:c14n5 skos:example "2024-05" ;
	linkml:tag "publication_date"^^xsd:anyURI .
_:c14n6 sh:namespace "https://w3id.org/lmodel/nist-sp-800-171/"^^xsd:anyURI ;
	sh:prefix "nist_sp_800_171" .
_:c14n7 sh:namespace "http://schema.org/"^^xsd:anyURI ;
	sh:prefix "schema" .

