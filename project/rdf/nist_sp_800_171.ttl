	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Reference"^^xsd:anyURI ;
	linkml:description "A publication that SP 800-171 lists under a requirement's references, by the short name the publication gives it, with the full citation and the address NIST's catalog gives it." ;
	linkml:slot_usage _:c14n11 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication_citation> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Reference__cited_publication_url> .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/pubs/sp/800/171/r3/final"^^xsd:anyURI ;
	skos:broadMatch "oscal:Control"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_171:Requirement"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-171/addressed_by_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/incorporated_into_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_discussion> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_id> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_items> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_methods> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_objectives> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_parameters> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_references> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_statement> , <https://w3id.org/lmodel/nist-sp-800-171/requirement_status> , <https://w3id.org/lmodel/nist-sp-800-171/source_controls> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-171/Requirement"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Requirement"^^xsd:anyURI ;
	linkml:description "A security requirement of SP 800-171: a numbered, named requirement for protecting CUI, with its statement, discussion, references and source controls, the organization-defined parameters its statement leaves open, and the assessment objectives and methods SP 800-171A gives it. A requirement that Revision 3 withdrew keeps its number and says which requirements took its place." ;
	linkml:slot_usage _:c14n1 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/description> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__addressed_by_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__incorporated_into_requirements> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_discussion> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_id> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_items> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_methods> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_objectives> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_parameters> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_references> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_statement> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__requirement_status> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Requirement__source_controls> , <https://w3id.org/lmodel/nist-sp-800-171/title> .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171RequirementItem> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/pubs/sp/800/171/r3/final"^^xsd:anyURI ;
	skos:broadMatch "oscal:Part"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_171:RequirementItem"^^xsd:anyURI ;
