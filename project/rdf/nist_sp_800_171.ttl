	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
