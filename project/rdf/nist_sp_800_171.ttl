	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171AssessmentMethod"^^xsd:anyURI ;
	linkml:description "One of the three assessment methods SP 800-171A applies to a requirement, examine, interview or test, with the assessment objects (documents, people, processes or mechanisms) it is applied to." ;
	linkml:slot_usage _:c14n10 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentMethod__requirement_method_kind> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171AssessmentMethod__requirement_method_objects> .
