	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-171/Family"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family"^^xsd:anyURI ;
	linkml:description "One of the seventeen families that SP 800-171 Revision 3 sorts its security requirements into, such as Access Control (03.01) or Supply Chain Risk Management (03.17)." ;
	linkml:slot_usage _:c14n14 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family_title> , <https://w3id.org/lmodel/nist-sp-800-171/description> , <https://w3id.org/lmodel/nist-sp-800-171/family_number> , <https://w3id.org/lmodel/nist-sp-800-171/sp800171Family__family_requirements> .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family_title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	skos:prefLabel "title" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/title"^^xsd:anyURI ;
	linkml:description "The name SP 800-171 gives a family or a security requirement, such as Access Control or Account Management." ;
	linkml:domain <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:is_a <https://w3id.org/lmodel/nist-sp-800-171/title> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-171/Sp800171Family> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-171/string> ;
	linkml:required true ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI ;
	linkml:usage_slot_name "title" .
<https://w3id.org/lmodel/nist-sp-800-171/Sp800171Parameter> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://doi.org/10.6028/NIST.SP.800-171Ar3"^^xsd:anyURI ;
	skos:broadMatch "oscal:Parameter"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_171:Parameter"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-171"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-171/odp_choices> , <https://w3id.org/lmodel/nist-sp-800-171/odp_guideline> , <https://w3id.org/lmodel/nist-sp-800-171/odp_id> , <https://w3id.org/lmodel/nist-sp-800-171/odp_label> , <https://w3id.org/lmodel/nist-sp-800-171/odp_selection_count> , <https://w3id.org/lmodel/nist-sp-800-171/odp_usage> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-171/Parameter"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-171/Sp800171Parameter"^^xsd:anyURI ;
	linkml:description "An organization-defined parameter (ODP): a value, such as a time period or a frequency, that a requirement statement leaves to the organization, with the guideline SP 800-171A gives for defining it. A few parameters are a selection among choices instead of a value." ;
