@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nist_sp_800_171: <https://w3id.org/lmodel/nist-sp-800-171/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n136 , _:c14n138 , _:c14n140 , _:c14n142 , _:c14n144 , _:c14n146 , _:c14n148 .
<https://w3id.org/lmodel/nist-sp-800-171.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://doi.org/10.6028/NIST.SP.800-171r3> ;
	dcterms:title "Protecting Controlled Unclassified Information in Nonfederal Systems and Organizations (SP 800-171 Revision 3)" ;
	pav:version "3.0.0" ;
	a owl:Ontology ;
	rdfs:label "nist_sp_800_171" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/protecting-controlled-unclassified-information> , <https://csrc.nist.gov/pubs/sp/800/171/r3/final> , <https://doi.org/10.6028/NIST.SP.800-171Ar3> , <https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-171/rev3> , <https://lmodel.github.io/nist-sp-800-171> ;
	skos:definition "A LinkML model of NIST Special Publication 800-171 Revision 3, the security requirements for protecting controlled unclassified information (CUI) in nonfederal systems and organizations: its seventeen requirement families, each security requirement with its statement, discussion, references and source controls, the organization-defined parameters (ODPs) a requirement leaves to the organization, and the assessment objectives and methods that SP 800-171A Revision 3 gives each requirement." ;
	skos:note "NIST's catalog renders each family as an OSCAL group, each security requirement as an OSCAL control of class requirement, each statement item, discussion, assessment objective and assessment method as a part, each organization-defined parameter as a parameter, and each reference and source control as a link to a back-matter resource. The broad_mappings name those lmodel/oscal classes." , "SP 800-171 is a work of the United States Government and is not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each requirement, discussion, parameter and assessment procedure stays in the catalog copy." , "The version is the revision of SP 800-171 the schema renders, written as NIST's Cybersecurity and Privacy Reference Tool numbers it (SP_800_171_3_0_0), and source is the publication's digital object identifier. The catalog NIST publishes for that revision in usnistgov/oscal-content, which carries the assessment procedures of SP 800-171A Revision 3 as well, is copied to src/nist_sp_800_171/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer revision or changes the catalog. The catalog's own metadata version (1.1.0) numbers the catalog, not the publication. The release tags are the schema's own versions." ;
	nist_sp_800_171:cprt_framework_version "SP_800_171_3_0_0" ;
	nist_sp_800_171:oscal_content_commit "f0de6d8d8c059d374f15e0ae07508d82e370fc1d" ;
	nist_sp_800_171:oscal_content_tag "v1.6.0" ;
	nist_sp_800_171:publication_date "2024-05" .
nist_sp_800_171:Sp800171AssessmentMethod a owl:Class ;
	rdfs:label "Sp800171AssessmentMethod" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-171Ar3> ;
	rdfs:subClassOf _:c14n112 , _:c14n32 , _:c14n34 , _:c14n71 , _:c14n9 ;
	skos:broadMatch oscal:Part ;
	skos:definition "One of the three assessment methods SP 800-171A applies to a requirement, examine, interview or test, with the assessment objects (documents, people, processes or mechanisms) it is applied to." ;
	skos:exactMatch nist_sp_800_171:AssessmentMethod ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171AssessmentMethodKind\#examine a owl:Class ;
	rdfs:label "examine" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171AssessmentMethodKind ;
	skos:definition "Reviewing, inspecting, observing, studying or analysing assessment objects such as policies, plans, records and configurations." .
nist_sp_800_171:Sp800171AssessmentMethodKind\#interview a owl:Class ;
	rdfs:label "interview" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171AssessmentMethodKind ;
	skos:definition "Holding discussions with people such as administrators and personnel with security responsibilities." .
nist_sp_800_171:Sp800171AssessmentMethodKind\#test a owl:Class ;
	rdfs:label "test" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171AssessmentMethodKind ;
	skos:definition "Exercising mechanisms or processes under specified conditions and comparing the result with what is expected." .
nist_sp_800_171:Sp800171AssessmentMethodKind a owl:Class ;
	rdfs:label "Sp800171AssessmentMethodKind" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-171Ar3> ;
	owl:unionOf _:c14n26 ;
	skos:definition "The three assessment methods of SP 800-171A." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
	linkml:permissible_values nist_sp_800_171:Sp800171AssessmentMethodKind\#examine , nist_sp_800_171:Sp800171AssessmentMethodKind\#interview , nist_sp_800_171:Sp800171AssessmentMethodKind\#test .
nist_sp_800_171:Sp800171AssessmentObjective a owl:Class ;
	rdfs:label "Sp800171AssessmentObjective" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-171Ar3> ;
	rdfs:subClassOf _:c14n31 , _:c14n44 , _:c14n45 , _:c14n53 , _:c14n6 , _:c14n69 , _:c14n78 , _:c14n79 , _:c14n94 ;
	skos:broadMatch oscal:Part ;
	skos:definition "An assessment objective of SP 800-171A: one determination statement that an assessor checks, tied to the requirement or to one item of its statement." ;
	skos:exactMatch nist_sp_800_171:AssessmentObjective ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171Family a owl:Class ;
	rdfs:label "Sp800171Family" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	rdfs:subClassOf _:c14n1 , _:c14n107 , _:c14n114 , _:c14n115 , _:c14n37 , _:c14n42 , _:c14n43 , _:c14n48 , _:c14n75 , _:c14n81 , _:c14n88 ;
	skos:broadMatch oscal:Group ;
	skos:definition "One of the seventeen families that SP 800-171 Revision 3 sorts its security requirements into, such as Access Control (03.01) or Supply Chain Risk Management (03.17)." ;
	skos:exactMatch nist_sp_800_171:Family ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171Parameter a owl:Class ;
	rdfs:label "Sp800171Parameter" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-171Ar3> ;
	rdfs:subClassOf _:c14n101 , _:c14n103 , _:c14n104 , _:c14n16 , _:c14n24 , _:c14n25 , _:c14n29 , _:c14n3 , _:c14n39 , _:c14n5 , _:c14n51 , _:c14n52 , _:c14n57 , _:c14n73 , _:c14n8 , _:c14n84 , _:c14n87 ;
	skos:broadMatch oscal:Parameter ;
	skos:definition "An organization-defined parameter (ODP): a value, such as a time period or a frequency, that a requirement statement leaves to the organization, with the guideline SP 800-171A gives for defining it. A few parameters are a selection among choices instead of a value." ;
	skos:exactMatch nist_sp_800_171:Parameter ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171Publication a owl:Class ;
	rdfs:label "Sp800171Publication" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	rdfs:subClassOf _:c14n27 , _:c14n28 , _:c14n49 , _:c14n64 , _:c14n93 ;
	skos:broadMatch oscal:Catalog ;
	skos:definition "One revision of SP 800-171 as a whole: its requirement families, each holding its security requirements, with the assessment procedures of the matching revision of SP 800-171A inside each requirement." ;
	skos:exactMatch nist_sp_800_171:Publication ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171Reference a owl:Class ;
	rdfs:label "Sp800171Reference" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	rdfs:subClassOf _:c14n10 , _:c14n100 , _:c14n36 , _:c14n38 , _:c14n46 , _:c14n54 , _:c14n63 , _:c14n7 , _:c14n90 ;
	skos:broadMatch oscal:Resource ;
	skos:definition "A publication that SP 800-171 lists under a requirement's references, by the short name the publication gives it, with the full citation and the address NIST's catalog gives it." ;
	skos:exactMatch nist_sp_800_171:Reference ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171Requirement a owl:Class ;
	rdfs:label "Sp800171Requirement" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	rdfs:subClassOf _:c14n105 , _:c14n106 , _:c14n108 , _:c14n11 , _:c14n110 , _:c14n111 , _:c14n113 , _:c14n17 , _:c14n18 , _:c14n20 , _:c14n22 , _:c14n30 , _:c14n35 , _:c14n4 , _:c14n40 , _:c14n41 , _:c14n55 , _:c14n56 , _:c14n58 , _:c14n59 , _:c14n65 , _:c14n66 , _:c14n67 , _:c14n68 , _:c14n74 , _:c14n76 , _:c14n80 , _:c14n82 , _:c14n86 , _:c14n91 , _:c14n92 , _:c14n95 , _:c14n96 , _:c14n97 ;
	skos:broadMatch oscal:Control ;
	skos:definition "A security requirement of SP 800-171: a numbered, named requirement for protecting CUI, with its statement, discussion, references and source controls, the organization-defined parameters its statement leaves open, and the assessment objectives and methods SP 800-171A gives it. A requirement that Revision 3 withdrew keeps its number and says which requirements took its place." ;
	skos:exactMatch nist_sp_800_171:Requirement ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171RequirementItem a owl:Class ;
	rdfs:label "Sp800171RequirementItem" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	rdfs:subClassOf _:c14n13 , _:c14n19 , _:c14n21 , _:c14n23 , _:c14n33 , _:c14n61 , _:c14n98 , _:c14n99 ;
	skos:broadMatch oscal:Part ;
	skos:definition "One item of a requirement statement: a lettered item such as 03.01.01.a, or a numbered item under a lettered one such as 03.01.01.c.01." ;
	skos:exactMatch nist_sp_800_171:RequirementItem ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:Sp800171RequirementStatus\#withdrawn a owl:Class ;
	rdfs:label "withdrawn" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171RequirementStatus ;
	skos:definition "Revision 3 withdrew the requirement; other requirements incorporate or address what it required, or nothing does." .
nist_sp_800_171:Sp800171RequirementStatus a owl:Class ;
	rdfs:label "Sp800171RequirementStatus" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/171/r3/final> ;
	skos:definition "The one status SP 800-171 Revision 3 states for a requirement. A requirement in force carries none." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
	linkml:permissible_values nist_sp_800_171:Sp800171RequirementStatus\#withdrawn .
nist_sp_800_171:Sp800171SelectionCount\#one a owl:Class ;
	rdfs:label "one" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171SelectionCount ;
	skos:definition "Exactly one of the choices." .
nist_sp_800_171:Sp800171SelectionCount\#one_or_more a owl:Class ;
	rdfs:label "one_or_more" ;
	rdfs:subClassOf nist_sp_800_171:Sp800171SelectionCount ;
	skos:definition "One or more of the choices." .
nist_sp_800_171:Sp800171SelectionCount a owl:Class ;
	rdfs:label "Sp800171SelectionCount" ;
	owl:unionOf _:c14n85 ;
	skos:definition "How many choices a selection parameter takes, as OSCAL states it." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
	linkml:permissible_values nist_sp_800_171:Sp800171SelectionCount\#one , nist_sp_800_171:Sp800171SelectionCount\#one_or_more .
nist_sp_800_171:addressed_by_requirements a owl:DatatypeProperty ;
	rdfs:label "addressed_by_requirements" ;
	skos:definition "For a withdrawn requirement, the requirements of Revision 3 that address what it required, as the catalog states them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:assessed_requirement_item a owl:DatatypeProperty ;
	rdfs:label "assessed_requirement_item" ;
	skos:definition "The statement item the objective assesses, such as 03.01.01.b. Absent when the objective assesses a requirement whose statement is one piece of text." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:cited_publication a owl:DatatypeProperty ;
	rdfs:label "cited_publication" ;
	skos:definition "The publication's short name, such as SP 800-63-3." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:cited_publication_citation a owl:DatatypeProperty ;
	rdfs:label "cited_publication_citation" ;
	skos:definition "The full citation, as the catalog's back matter gives it." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:cited_publication_url a owl:DatatypeProperty ;
	rdfs:label "cited_publication_url" ;
	skos:definition "The publication's address, which the catalog gives as its digital object identifier at doi.org." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the family or requirement is about, in the words of whoever records it. SP 800-171 gives a family no text of its own, and a requirement's own text goes in its statement, items and discussion." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
nist_sp_800_171:family_number a owl:DatatypeProperty ;
	rdfs:label "family_number" ;
	rdfs:range xsd:string ;
	skos:definition "The family's number, such as 03.01." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
	skos:note "A slot of its own, listed first in Sp800171Family's slots, rather than an attribute, so that the generated Python dataclasses key a list of families by their number and not by their title: they key an inlined list by the first required slot of the class, and a class lists its slots before its attributes. The adapt copy roots the family on LOKF's Concept, whose id is its identifier, so the number cannot be marked as one." .
nist_sp_800_171:family_requirements a owl:ObjectProperty ;
	rdfs:label "family_requirements" ;
	skos:definition "The security requirements of the family, the withdrawn ones included, in the order SP 800-171 numbers them. A knowledge bundle relates a requirement to its family with isPartOf instead." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:incorporated_into_requirements a owl:DatatypeProperty ;
	rdfs:label "incorporated_into_requirements" ;
	skos:definition "For a withdrawn requirement, the requirements of Revision 3 that incorporate what it required, as the catalog states them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_choices a owl:DatatypeProperty ;
	rdfs:label "odp_choices" ;
	skos:definition "For a selection, the choices SP 800-171 offers, in its order. A choice may itself carry an insert placeholder naming another parameter." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_guideline a owl:DatatypeProperty ;
	rdfs:label "odp_guideline" ;
	skos:definition "The determination SP 800-171A gives for the parameter: what the organization must have defined, such as the time period for account inactivity before disabling is defined." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_id a owl:DatatypeProperty ;
	rdfs:label "odp_id" ;
	skos:definition "The parameter's identifier, such as A.03.01.01.ODP[01]." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_label a owl:DatatypeProperty ;
	rdfs:label "odp_label" ;
	skos:definition "What kind of value the parameter takes, such as time period or frequency, or SELECTED PARAMETER VALUES for a selection." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_selection_count a owl:ObjectProperty ;
	rdfs:label "odp_selection_count" ;
	skos:definition "How many of the choices a selection takes." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:odp_usage a owl:DatatypeProperty ;
	rdfs:label "odp_usage" ;
	skos:definition "How the requirement statement names the parameter, such as organization-defined time period." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_determination a owl:DatatypeProperty ;
	rdfs:label "requirement_determination" ;
	skos:definition "The determination statement: what the assessor determines is the case, such as system accounts are created in accordance with organizational policy, procedures, prerequisites, and criteria." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_discussion a owl:DatatypeProperty ;
	rdfs:label "requirement_discussion" ;
	skos:definition "The requirement's discussion: SP 800-171's explanation of what the requirement means and how it relates to other requirements." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_families a owl:ObjectProperty ;
	rdfs:label "requirement_families" ;
	skos:definition "The requirement families, in the order SP 800-171 gives them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_id a owl:DatatypeProperty ;
	rdfs:label "requirement_id" ;
	skos:definition "The requirement's identifier, such as 03.01.01." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_item_id a owl:DatatypeProperty ;
	rdfs:label "requirement_item_id" ;
	skos:definition "The item's identifier, such as 03.01.01.a." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_item_text a owl:DatatypeProperty ;
	rdfs:label "requirement_item_text" ;
	skos:definition "What the item requires. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_items a owl:ObjectProperty ;
	rdfs:label "requirement_items" ;
	skos:definition "The lettered items of the requirement statement, in order, each with its numbered items where it has them. A requirement has either these or a statement, never both." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_method_kind a owl:ObjectProperty ;
	rdfs:label "requirement_method_kind" ;
	skos:definition "Which method it is." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_method_objects a owl:DatatypeProperty ;
	rdfs:label "requirement_method_objects" ;
	skos:definition "The assessment objects, one entry each, in the order SP 800-171A lists them, such as access control policy and procedures or system administrators." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_methods a owl:ObjectProperty ;
	rdfs:label "requirement_methods" ;
	skos:definition "The assessment methods SP 800-171A gives the requirement, each with the objects it is applied to." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_objective_id a owl:DatatypeProperty ;
	rdfs:label "requirement_objective_id" ;
	skos:definition "The objective's identifier, such as A.03.01.01.b[01]." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_objectives a owl:ObjectProperty ;
	rdfs:label "requirement_objectives" ;
	skos:definition "The assessment objectives SP 800-171A gives the requirement: the determination statements an assessor checks." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_parameters a owl:ObjectProperty ;
	rdfs:label "requirement_parameters" ;
	skos:definition "The organization-defined parameters the requirement statement leaves to the organization, in the order SP 800-171A numbers them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_references a owl:ObjectProperty ;
	rdfs:label "requirement_references" ;
	skos:definition "The publications SP 800-171 lists under the requirement's references, each with its citation and address as the catalog gives them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_statement a owl:DatatypeProperty ;
	rdfs:label "requirement_statement" ;
	skos:definition "The requirement statement when SP 800-171 writes it as one piece of text and not as lettered items. The catalog marks an organization-defined parameter in the text with an insert placeholder that names the parameter." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_status a owl:ObjectProperty ;
	rdfs:label "requirement_status" ;
	skos:definition "Withdrawn when Revision 3 withdrew the requirement. A requirement with no status is in force." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:requirement_subitems a owl:ObjectProperty ;
	rdfs:label "requirement_subitems" ;
	skos:definition "The numbered items under a lettered item, in order." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:source_controls a owl:DatatypeProperty ;
	rdfs:label "source_controls" ;
	skos:definition "The controls of SP 800-53 Revision 5 the requirement is drawn from, by their identifiers, as the catalog lists them among the requirement's references. The identifier is data; the schema maps nothing to a model of SP 800-53." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:sp800171_revision a owl:DatatypeProperty ;
	rdfs:label "sp800171_revision" ;
	skos:definition "The revision of SP 800-171 the document renders, as NIST numbers it, such as 3." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> .
nist_sp_800_171:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The name SP 800-171 gives a family or a security requirement, such as Access Control or Account Management." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-171> ;
